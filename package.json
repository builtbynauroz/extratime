{
  "name": "extratime",
  "version": "0.1.0",
  "description": "A terminal coding agent on your own Anthropic API key, built on the Claude Agent SDK. Powered by Claude.",
  "license": "MIT",
  "author": "builtbynauroz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/builtbynauroz/extratime.git"
  },
  "homepage": "https://github.com/builtbynauroz/extratime#readme",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "agent-sdk",
    "api-key",
    "usage-limit",
    "cli"
  ],
  "type": "module",
  "bin": {
    "extratime": "bin/extratime.js"
  },
  "files": [
    "bin",
    "src",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "frames": "tsx design/frames.tsx"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "ink": "^8.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
